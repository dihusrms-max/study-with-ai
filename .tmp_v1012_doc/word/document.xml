Band="1" w:val="04A0"/></w:tblPr><w:tblGrid><w:gridCol w:w="2592"/><w:gridCol w:w="2592"/><w:gridCol w:w="2592"/><w:gridCol w:w="2592"/></w:tblGrid><w:tr><w:tc><w:tcPr><w:tcW w:type="dxa" w:w="2592"/></w:tcPr><w:p><w:r><w:t>구분</w:t></w:r></w:p></w:tc><w:tc><w:tcPr><w:tcW w:type="dxa" w:w="2592"/></w:tcPr><w:p><w:r><w:t>Baseline</w:t></w:r></w:p></w:tc><w:tc><w:tcPr><w:tcW w:type="dxa" w:w="2592"/></w:tcPr><w:p><w:r><w:t>Candidate</w:t></w:r></w:p></w:tc><w:tc><w:tcPr><w:tcW w:type="dxa" w:w="2592"/></w:tcPr><w:p><w:r><w:t>판정</w:t></w:r></w:p></w:tc></w:tr><w:tr><w:tc><w:tcPr><w:tcW w:type="dxa" w:w="2592"/><w:vAlign w:val="center"/></w:tcPr><w:p><w:r><w:t>32건 반복 R1</w:t></w:r></w:p></w:tc><w:tc><w:tcPr><w:tcW w:type="dxa" w:w="2592"/><w:vAlign w:val="center"/></w:tcPr><w:p><w:r><w:t>-</w:t></w:r></w:p></w:tc><w:tc><w:tcPr><w:tcW w:type="dxa" w:w="2592"/><w:vAlign w:val="center"/></w:tcPr><w:p><w:r><w:t>v13 F1 0.3000</w:t></w:r></w:p></w:tc><w:tc><w:tcPr><w:tcW w:type="dxa" w:w="2592"/><w:vAlign w:val="center"/></w:tcPr><w:p><w:r><w:t>방향성 확인</w:t></w:r></w:p></w:tc></w:tr><w:tr><w:tc><w:tcPr><w:tcW w:type="dxa" w:w="2592"/><w:vAlign w:val="center"/></w:tcPr><w:p><w:r><w:t>32건 반복 R2</w:t></w:r></w:p></w:tc><w:tc><w:tcPr><w:tcW w:type="dxa" w:w="2592"/><w:vAlign w:val="center"/></w:tcPr><w:p><w:r><w:t>-</w:t></w:r></w:p></w:tc><w:tc><w:tcPr><w:tcW w:type="dxa" w:w="2592"/><w:vAlign w:val="center"/></w:tcPr><w:p><w:r><w:t>v13 F1 0.3529</w:t></w:r></w:p></w:tc><w:tc><w:tcPr><w:tcW w:type="dxa" w:w="2592"/><w:vAlign w:val="center"/></w:tcPr><w:p><w:r><w:t>방향성 확인</w:t></w:r></w:p></w:tc></w:tr><w:tr><w:tc><w:tcPr><w:tcW w:type="dxa" w:w="2592"/><w:vAlign w:val="center"/></w:tcPr><w:p><w:r><w:t>32건 반복 R3</w:t></w:r></w:p></w:tc><w:tc><w:tcPr><w:tcW w:type="dxa" w:w="2592"/><w:vAlign w:val="center"/></w:tcPr><w:p><w:r><w:t>-</w:t></w:r></w:p></w:tc><w:tc><w:tcPr><w:tcW w:type="dxa" w:w="2592"/><w:vAlign w:val="center"/></w:tcPr><w:p><w:r><w:t>v13 F1 0.3636</w:t></w:r></w:p></w:tc><w:tc><w:tcPr><w:tcW w:type="dxa" w:w="2592"/><w:vAlign w:val="center"/></w:tcPr><w:p><w:r><w:t>방향성 확인</w:t></w:r></w:p></w:tc></w:tr><w:tr><w:tc><w:tcPr><w:tcW w:type="dxa" w:w="2592"/><w:vAlign w:val="center"/></w:tcPr><w:p><w:r><w:t>64건 v13 F1</w:t></w:r></w:p></w:tc><w:tc><w:tcPr><w:tcW w:type="dxa" w:w="2592"/><w:vAlign w:val="center"/></w:tcPr><w:p><w:r><w:t>0.1818</w:t></w:r></w:p></w:tc><w:tc><w:tcPr><w:tcW w:type="dxa" w:w="2592"/><w:vAlign w:val="center"/></w:tcPr><w:p><w:r><w:t>0.1290</w:t></w:r></w:p></w:tc><w:tc><w:tcPr><w:tcW w:type="dxa" w:w="2592"/><w:vAlign w:val="center"/></w:tcPr><w:p><w:r><w:t>REJECT</w:t></w:r></w:p></w:tc></w:tr><w:tr><w:tc><w:tcPr><w:tcW w:type="dxa" w:w="2592"/><w:vAlign w:val="center"/></w:tcPr><w:p><w:r><w:t>64건 TP</w:t></w:r></w:p></w:tc><w:tc><w:tcPr><w:tcW w:type="dxa" w:w="2592"/><w:vAlign w:val="center"/></w:tcPr><w:p><w:r><w:t>3</w:t></w:r></w:p></w:tc><w:tc><w:tcPr><w:tcW w:type="dxa" w:w="2592"/><w:vAlign w:val="center"/></w:tcPr><w:p><w:r><w:t>2</w:t></w:r></w:p></w:tc><w:tc><w:tcPr><w:tcW w:type="dxa" w:w="2592"/><w:vAlign w:val="center"/></w:tcPr><w:p><w:r><w:t>악화</w:t></w:r></w:p></w:tc></w:tr><w:tr><w:tc><w:tcPr><w:tcW w:type="dxa" w:w="2592"/><w:vAlign w:val="center"/></w:tcPr><w:p><w:r><w:t>64건 FP</w:t></w:r></w:p></w:tc><w:tc><w:tcPr><w:tcW w:type="dxa" w:w="2592"/><w:vAlign w:val="center"/></w:tcPr><w:p><w:r><w:t>24</w:t></w:r></w:p></w:tc><w:tc><w:tcPr><w:tcW w:type="dxa" w:w="2592"/><w:vAlign w:val="center"/></w:tcPr><w:p><w:r><w:t>23</w:t></w:r></w:p></w:tc><w:tc><w:tcPr><w:tcW w:type="dxa" w:w="2592"/><w:vAlign w:val="center"/></w:tcPr><w:p><w:r><w:t>소폭 개선</w:t></w:r></w:p></w:tc></w:tr><w:tr><w:tc><w:tcPr><w:tcW w:type="dxa" w:w="2592"/><w:vAlign w:val="center"/></w:tcPr><w:p><w:r><w:t>64건 FN</w:t></w:r></w:p></w:tc><w:tc><w:tcPr><w:tcW w:type="dxa" w:w="2592"/><w:vAlign w:val="center"/></w:tcPr><w:p><w:r><w:t>3</w:t></w:r></w:p></w:tc><w:tc><w:tcPr><w:tcW w:type="dxa" w:w="2592"/><w:vAlign w:val="center"/></w:tcPr><w:p><w:r><w:t>4</w:t></w:r></w:p></w:tc><w:tc><w:tcPr><w:tcW w:type="dxa" w:w="2592"/><w:vAlign w:val="center"/></w:tcPr><w:p><w:r><w:t>악화</w:t></w:r></w:p></w:tc></w:tr><w:tr><w:tc><w:tcPr><w:tcW w:type="dxa" w:w="2592"/><w:vAlign w:val="center"/></w:tcPr><w:p><w:r><w:t>비표적 변경</w:t></w:r></w:p></w:tc><w:tc><w:tcPr><w:tcW w:type="dxa" w:w="2592"/><w:vAlign w:val="center"/></w:tcPr><w:p><w:r><w:t>0</w:t></w:r></w:p></w:tc><w:tc><w:tcPr><w:tcW w:type="dxa" w:w="2592"/><w:vAlign w:val="center"/></w:tcPr><w:p><w:r><w:t>0</w:t></w:r></w:p></w:tc><w:tc><w:tcPr><w:tcW w:type="dxa" w:w="2592"/><w:vAlign w:val="center"/></w:tcPr><w:p><w:r><w:t>PASS</w:t></w:r></w:p></w:tc></w:tr></w:tbl><w:p><w:r><w:t>추가된 32건이 모두 v13 음성 사례였고, 그중 13건을 양성으로 오판했다. 핵심 문제는 v13 탐지 범위를 넓히는 과정에서 decision boundary가 과도하게 확장된 것이다.</w:t></w:r></w:p><w:p><w:pPr><w:pStyle w:val="Heading1"/></w:pPr><w:r><w:t>2. 시스템 판정</w:t></w:r></w:p><w:p><w:r><w:t>• v10.1.1 Request Identity Gate: GO</w:t></w:r></w:p><w:p><w:r><w:t>• v10.1.1 Stability Gate: GO</w:t></w:r></w:p><w:p><w:r><w:t>• target-only 비표적 변경 0: GO</w:t></w:r></w:p><w:p><w:r><w:t>• P005 현재 Candidate: REJECT</w:t></w:r></w:p><w:p><w:r><w:t>• Dev200 재실행: STOP</w:t></w:r></w:p><w:p><w:r><w:t>• Student merge / 제출: STOP</w:t></w:r></w:p><w:p><w:pPr><w:pStyle w:val="Heading1"/></w:pPr><w:r><w:t>3. 개선 핵심 — Negative Gate를 Dual Calibration Gate로 확장</w:t></w:r></w:p><w:p><w:r><w:rPr><w:rFonts w:ascii="Consolas" w:hAnsi="Consolas"/></w:rPr><w:t xml:space="preserve">              v13 Candidate</w:t><w:br/><w:t xml:space="preserve">                    │</w:t><w:br/><w:t xml:space="preserve">        ┌───────────┴───────────┐</w:t><w:br/><w:t xml:space="preserve">        ↓                       ↓</w:t><w:br/><w:t xml:space="preserve">  Positive Guard           Hard Negative</w:t><w:br/><w:t xml:space="preserve">   TP / FN 보존             FP / TN 억제</w:t><w:br/><w:t xml:space="preserve">        │                       │</w:t><w:br/><w:t xml:space="preserve">        └───────────┬───────────┘</w:t><w:br/><w:t xml:space="preserve">                    ↓</w:t><w:br/><w:t xml:space="preserve">                  PASS?</w:t></w:r></w:p><w:p><w:r><w:t>FP만 줄이는 Negative-Pool Gate로 가면 P005A처럼 TP까지 죽일 위험이 있다. 따라서 Positive Guard와 Hard Negative Gate를 동시에 통과해야 다음 단계로 승격한다.</w:t></w:r></w:p><w:p><w:pPr><w:pStyle w:val="Heading1"/></w:pPr><w:r><w:t>4. v13 Regression Bank</w:t></w:r></w:p><w:p><w:r><w:t>이번 실패 사례를 버리지 않고 다음 Candidate의 고정 회귀 테스트 자산으로 저장한다.</w:t></w:r></w:p><w:p><w:r><w:t>• Recovered FN / Positive Guard 사례</w:t></w:r></w:p><w:p><w:r><w:t>• 기존 TP 사례</w:t></w:r></w:p><w:p><w:r><w:t>• 이번 64건에서 발견된 13 Hard Negative</w:t></w:r></w:p><w:p><w:r><w:t>• 대표 TN</w:t></w:r></w:p><w:p><w:r><w:t>• Boundary / Similar-phrase TN</w:t></w:r></w:p><w:p><w:pPr><w:pStyle w:val="Heading1"/></w:pPr><w:r><w:t>5. 다음 실험 — 가장 효율적인 순서</w:t></w:r></w:p><w:p><w:r><w:t>1. 보수형 v13 프롬프트 Candidate 생성.</w:t></w:r></w:p><w:p><w:r><w:t>2. Positive Guard + 13 Hard Negative + 일부 대표 TN으로 20~30건 Calibration Pack 구성.</w:t></w:r></w:p><w:p><w:r><w:t>3. Calibration Pack에서 Dual Gate FAIL이면 즉시 REJECT.</w:t></w:r></w:p><w:p><w:r><w:t>4. PASS한 Candidate만 64건 1회 실행.</w:t></w:r></w:p><w:p><w:r><w:t>5. 64건 PASS한 Candidate만 동일 Request Identity로 추가 2회 반복해 Stability 확인.</w:t></w:r></w:p><w:p><w:r><w:t>6. 반복 안정성까지 통과한 Candidate만 Dev200으로 확대.</w:t></w:r></w:p><w:p><w:pPr><w:pStyle w:val="Heading1"/></w:pPr><w:r><w:t>6. 권장 Gate</w:t></w:r></w:p><w:p><w:r><w:t>• Request Identity = PASS</w:t></w:r></w:p><w:p><w:r><w:t>• TP &gt;= 동일 pool baseline TP</w:t></w:r></w:p><w:p><w:r><w:t>• FN &lt;= 동일 pool baseline FN</w:t></w:r></w:p><w:p><w:r><w:t>• Target v13 F1 &gt; 동일 pool baseline v13 F1</w:t></w:r></w:p><w:p><w:r><w:t>• Hard-negative FP가 이전 Candidate 대비 유의미하게 감소</w:t></w:r></w:p><w:p><w:r><w:t>• non-target harmful changes = 0 우선</w:t></w:r></w:p><w:p><w:r><w:t>• JSON / Evidence errors = 0</w:t></w:r></w:p><w:p><w:r><w:rPr><w:b/></w:rPr><w:t xml:space="preserve">주의: </w:t></w:r><w:r><w:t>`FP &lt;= baseline`을 절대 단독 탈락조건으로 사용하지 않는다. FP는 Target F1, TP/FN 보존, Hard Negative 회복과 함께 평가한다.</w:t></w:r></w:p><w:p><w:pPr><w:pStyle w:val="Heading1"/></w:pPr><w:r><w:t>7. 다음 한 수</w:t></w:r></w:p><w:p><w:r><w:rPr><w:b/></w:rPr><w:t xml:space="preserve">최우선: </w:t></w:r><w:r><w:t>보수형 v13 프롬프트를 20~30건 Dual Calibration Pack에서 먼저 검증한다. 통과하지 못하면 64건/Dev200 API를 쓰지 않는다.</w:t></w:r></w:p><w:p><w:pPr><w:jc w:val="center"/></w:pPr><w:r><w:rPr><w:b/><w:sz w:val="22"/></w:rPr><w:t>핵심 목표: 더 많은 Candidate를 만드는 것이 아니라, 좋은 Candidate와 나쁜 Candidate를 더 적은 API로 구분한다.</w:t></w:r></w:p><w:sectPr w:rsidR="00FC693F" w:rsidRPr="0006063C" w:rsidSect="00034616"><w:pgSz w:w="12240" w:h="15840"/><w:pgMar w:top="792" w:right="936" w:bottom="792" w:left="936" w:header="720" w:footer="720" w:gutter="0"/><w:cols w:space="720"/><w:docGrid w:linePitch="360"/></w:sectPr></w:body></w:document>