# Codex exec policy for DACON
# Windows location:
#   %USERPROFILE%\.codex\rules\default.rules

# Safe, read-only Git inspection.
prefix_rule(
    pattern = ["git", "status"],
    decision = "allow",
    justification = "Read-only repository status inspection",
)

prefix_rule(
    pattern = ["git", "diff"],
    decision = "allow",
    justification = "Read-only diff inspection",
)

prefix_rule(
    pattern = ["git", "log"],
    decision = "allow",
    justification = "Read-only commit-history inspection",
)

prefix_rule(
    pattern = ["git", "rev-parse"],
    decision = "allow",
    justification = "Read-only repository identity/path inspection",
)

prefix_rule(
    pattern = ["git", "ls-files"],
    decision = "allow",
    justification = "Read-only tracked-file inspection",
)

prefix_rule(
    pattern = ["git", "branch", "--show-current"],
    decision = "allow",
    justification = "Read-only current-branch inspection",
)

# Remote/history-changing operations keep explicit review.
prefix_rule(
    pattern = ["git", "push"],
    decision = "prompt",
    justification = "Remote repository mutation requires explicit review",
)

prefix_rule(
    pattern = ["git", "merge"],
    decision = "prompt",
    justification = "Shared-history integration requires explicit review",
)

prefix_rule(
    pattern = ["git", "rebase"],
    decision = "prompt",
    justification = "History rewriting/integration requires explicit review",
)

prefix_rule(
    pattern = ["git", "reset", "--hard"],
    decision = "prompt",
    justification = "Destructive working-tree/history reset requires explicit review",
)

prefix_rule(
    pattern = ["git", "clean"],
    decision = "prompt",
    justification = "Potentially destructive removal of untracked files requires explicit review",
)
